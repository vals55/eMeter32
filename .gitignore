# PlatformIO build output and caches
.pio/
.pioenvs/
.piolibdeps/

# ESP-IDF generated configuration (only sdkconfig.defaults is tracked)
sdkconfig
sdkconfig.*
!sdkconfig.defaults
dependencies.lock

# Build logs written by the serial monitor filter (log2file)
*.log

# Editors and IDEs
.vscode/
!.vscode/extensions.json
.idea/
*.code-workspace

# OS files
.DS_Store
Thumbs.db
desktop.ini
*.bat

# Local secrets (never commit Wi-Fi or MQTT credentials)
*.secret
secrets.*
